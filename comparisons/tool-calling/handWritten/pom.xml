<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.customercompass.comparisons</groupId>
    <artifactId>comparisons</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>tool-calling-hand-written</artifactId>
  <name>tool-calling-hand-written</name>
  <description>Tool calling with no AI framework: our own loop over the model's HTTP API (JDK HttpClient and Jackson only)</description>

  <dependencies>
    <dependency>
      <groupId>com.customercompass.comparisons</groupId>
      <artifactId>comparisons-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>${toolcalling.exec.skip}</skip>
          <mainClass>com.customercompass.comparisons.toolcalling.handwritten.HandWrittenMain</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
