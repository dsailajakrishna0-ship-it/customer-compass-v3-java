<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.customercompass.comparisons</groupId>
    <artifactId>comparisons</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>agent-graph-with-langgraph4j</artifactId>
  <name>agent-graph-with-langgraph4j</name>
  <description>A simple agent with an approval pause built with LangGraph4j: a StateGraph, a checkpoint saver and an interrupt before the approval node</description>

  <properties>
    <!-- the version the application uses (apps/api-java/pom.xml) -->
    <langgraph4j.version>1.9.9</langgraph4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.customercompass.comparisons</groupId>
      <artifactId>comparisons-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bsc.langgraph4j</groupId>
      <artifactId>langgraph4j-core</artifactId>
      <version>${langgraph4j.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <mainClass>com.customercompass.comparisons.agentgraph.withlanggraph4j.LangGraph4jAgentMain</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
