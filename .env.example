# Copy to .env and fill in. Never commit .env. Placeholders only in this file.
# Real keys go only in .env (it is git-ignored).

# Embeddings (Google AI Studio, free tier): https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Chat models (OpenRouter, free ":free" models only): https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Database (used from J1)
# DATABASE_URL=jdbc:postgresql://localhost:5432/customer_compass
# DATABASE_USER=customer_compass
# DATABASE_PASSWORD=

# Documents and search (J3): where Qdrant runs (the Java client talks gRPC) and which collection to use
# QDRANT_HOST=localhost
# QDRANT_GRPC_PORT=6334        # 26334 when you use `just qdrant`
# QDRANT_COLLECTION=java_document_chunks

