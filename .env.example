# Copy to .env and fill in. Never commit .env. Placeholders only in this file.
# Real keys go only in .env (it is git-ignored).

# Embeddings (Google AI Studio, free tier): https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Chat models (OpenRouter, free ":free" models only): https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Database (used from J1)
# DATABASE_URL=jdbc:postgresql://localhost:5432/customer_compass
# DATABASE_USER=customer_compass
# DATABASE_PASSWORD=

# Documents and search (J3): where Qdrant runs (the Java client talks gRPC) and which collection to use
# QDRANT_HOST=localhost
# QDRANT_GRPC_PORT=6334        # 26334 when you use `just qdrant`
# QDRANT_COLLECTION=java_document_chunks

# MCP tool servers for the tools chat (J4). The Java server is this API itself at /mcp; nothing to set for it.
# MCP_BACKEND=springboot              # the server used when a request does not name one: springboot | fastmcp
# MCP_FASTMCP_URL=http://localhost:8002/mcp   # optional: the Python edition's tool server, if you run it

# The account follow-up agent's hard limits (J5). The defaults are the Python edition's.
# AGENT_MAX_STEPS=8
# AGENT_TIMEOUT_SECONDS=180
# AGENT_MAX_REVISIONS=1

# Tracing (J7.3): off by default. Spans carry counts, model names and durations, never questions, answers or document text.
# TRACING_ENABLED=false                       # true: send spans to the endpoint below
# TRACING_ENDPOINT=http://localhost:3000/api/public/otel   # Langfuse's OpenTelemetry endpoint (the Python edition's compose profile "observability")
# LANGFUSE_PUBLIC_KEY=                        # from a Langfuse project (Settings, API keys); never commit them
# LANGFUSE_SECRET_KEY=
# TRACING_SERVICE_NAME=customer-compass-java
# TRACING_EXPORT_TIMEOUT_SECONDS=5
